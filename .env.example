# Local settings: copy to .env and fill in. Never commit .env.
# In production, prefer secrets as files from a secret store (docs/PRODUCTION.md, docker-compose.secrets.yml).

# ---- Secrets (local use) ----
# Telegram app: https://my.telegram.org -> API development tools (register with a company number)
TG_API_ID=
TG_API_HASH=

# Database password (used by both postgres and the api container)
POSTGRES_PASSWORD=change-me-local

# Master key (32 bytes, base64): encrypts the data that would let someone take over an account,
# i.e. each user's linked Telegram session and their authenticator (TOTP) secret. A stolen
# database is useless without it. Lose it and every user must link Telegram and set up the
# authenticator again. Generate once: head -c 32 /dev/urandom | base64
# Leave empty locally: one is generated into the data volume on first start.
MASTER_KEY=

# abuse.ch (MalwareBazaar, URLhaus) downloads: free key from https://auth.abuse.ch
ABUSECH_AUTH_KEY=

# local-only (default): nothing about files or links leaves the service.
# local+vt: also VirusTotal GET lookups by hash / URL hash / domain (needs VT_API_KEY;
#           the free key is for testing only, business use needs a VT licence). Never uploads files.
REPUTATION_MODE=local-only
VT_API_KEY=

# ---- Automatic scanning ----
# AUTO_SCAN=true
# AUTO_SCAN_MAX_MB=50                 # bigger files are scanned when the user clicks "Scan"
# AUTO_SCAN_CHATS=private,group,bot   # add ",channel" to scan channel posts too
# AUTO_SCAN_OUTGOING=false
# AUTO_SCAN_PHOTOS=false              # photos are checked when a chat is opened, not on arrival
# IMAGE_FAST_PATH=true                # verified incoming pictures: type check + hash + re-encode, no ClamAV/YARA
# MAX_FILE_MB=100

# ---- Feeds ----
# FEEDS_MALWAREBAZAAR_FULL=false
# FEEDS_YARA_FORGE=true
# FEEDS_INTERVAL_MIN=60
# Optional feed URL overrides ({key} is replaced by ABUSECH_AUTH_KEY):
# FEED_URL_MALWAREBAZAAR_FULL=
# FEED_URL_URLHAUS_HOSTS=

# ---- Retention and sessions ----
# CLEAN_RETENTION_DAYS=7
# QUARANTINE_RETENTION_DAYS=30
# LINK_RETENTION_DAYS=30
# SESSION_MAX_HOURS=8
# SESSION_IDLE_MIN=60

# ---- Web ----
# COOKIE_SECURE=false                 # true behind HTTPS (set by docker-compose.prod.yml)
# SECURITY_CONTACT=mailto:security@example.com   # RFC 9116, served at /.well-known/security.txt
# Admin area through the public address, from these client IPs / CIDRs only (comma-separated).
# Empty (default): admin area only through the localhost admin entrance (SSH tunnel to :8081).
# List only addresses you control (office, VPN exit). Admins still need password + authenticator.
# ADMIN_ALLOWED_IPS=203.0.113.7,198.51.100.0/28

# ---- Egress allowlist (comma-separated; a leading dot also allows subdomains) ----
# SERVICE_ALLOWED_DOMAINS=.abuse.ch,openphish.com,raw.githubusercontent.com,tranco-list.eu,github.com,objects.githubusercontent.com,release-assets.githubusercontent.com,www.virustotal.com,.clamav.net
